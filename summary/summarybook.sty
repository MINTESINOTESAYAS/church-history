%% summarybook.sty -- design of the summary volume (pdfLaTeX).
%%
%% The content files use only the commands defined here:
%%   \summarypart{ONE}{Title}{dates}  partoverview  \partchapters{...} with \pch{n}{Title}{Subtitle}
%%   \summarychapter{n}{Title}{Subtitle}   inbrief (with \question{...})   \ssection{...}
%%   sidebox{Title}   keyfacts with \keypeople{..} \keydates{\kd{year}{event}...} \keyterms{..}
%%   \frontchapter{Title}  \backchapter{Title}   sumtable (small tables) with \sumhead{..}
%%   back matter (generated): chronology with \chronhead \chron \chronmore \chref;  popecolumns with \pope
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{summarybook}[2026/11/11 design of the summary volume]

%% ---------------------------------------------------------------------------------------
%% Fonts and page
%% ---------------------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}
\RequirePackage{mathpazo}                 % Palatino for the text
\RequirePackage[scaled=0.86]{helvet}      % Helvetica for labels
\linespread{1.06}
\IfFileExists{glyphtounicode.tex}{\input{glyphtounicode}\pdfgentounicode=1 }{}

\RequirePackage[paperwidth=6in,paperheight=9in,inner=0.88in,outer=0.72in,
                top=0.95in,bottom=0.9in,headheight=14pt,headsep=18pt,footskip=28pt]{geometry}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{multicol}
\RequirePackage{fancyhdr}
\RequirePackage[framemethod=default]{mdframed}

\definecolor{sbaccent}{HTML}{7A1F1F}      % oxblood: numbers, labels, section heads
\definecolor{sbtint}{HTML}{F6F0E5}        % warm paper tint: boxes
\definecolor{sbgray}{HTML}{666666}        % subtitles
\definecolor{sbrule}{HTML}{BBA98A}        % thin rules

\frenchspacing
\raggedbottom
\setlength{\parindent}{1.15em}
\setlength{\parskip}{0pt}
\tolerance=600
\setlength{\emergencystretch}{2em}
\hbadness=2500
\clubpenalty=8000 \@clubpenalty=\clubpenalty \widowpenalty=8000

%% Small letter-spaced capitals in the label font.
\newcommand*{\sblabel}[1]{{\sffamily\scriptsize\color{sbaccent}\textls[130]{\MakeUppercase{#1}}}}

%% ---------------------------------------------------------------------------------------
%% Running heads
%% ---------------------------------------------------------------------------------------
\newcommand*{\sbbooktitle}{Church History in Plain Language: A Summary}
\newcommand*{\sb@headfont}{\sffamily\scriptsize\color{sbgray}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\sb@headfont\textbf{\thepage}\hspace{1.2em}\textls[90]{\MakeUppercase{\sbbooktitle}}}
\fancyhead[RO]{\sb@headfont\textls[90]{\MakeUppercase{\rightmark}}\hspace{1.2em}\textbf{\thepage}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sb@headfont\textbf{\thepage}}}
\newcommand*{\sb@cleartorecto}{\clearpage
  \if@twoside\ifodd\c@page\else\hbox{}\thispagestyle{empty}\newpage\fi\fi}
\let\cleardoublepage\sb@cleartorecto

%% ---------------------------------------------------------------------------------------
%% Parts
%% ---------------------------------------------------------------------------------------
\newcommand{\summarypart}[3]{%
  \sb@cleartorecto\thispagestyle{empty}%
  \refstepcounter{part}%
  \addcontentsline{toc}{part}{\protect\sbtocpart{#1}{#2}{#3}}%
  \markboth{#2}{#2}%
  \vspace*{0.11\textheight minus 0.07\textheight}%   may shrink, so that the page can hold a few more lines
  \begingroup\centering
    {\sffamily\small\color{sbaccent}\textls[220]{PART #1}\par}\vspace{16pt}%
    {\huge #2\par}\vspace{10pt}%
    {\Large\itshape\color{sbgray}#3\par}\vspace{18pt}%
    {\color{sbaccent}\rule{3.2em}{1.2pt}\par}%
  \endgroup
  \vspace{20pt}}
\newenvironment{partoverview}
  {\list{}{\leftmargin=1.4em \rightmargin=1.4em \topsep=0pt \partopsep=0pt \parsep=0.5\baselineskip
           \listparindent=0pt \itemindent=0pt}\item\relax}
  {\endlist}
%% The chapter list of a part is never divided: it stands on the part page or, whole, on the next page.
\newcommand{\partchapters}[1]{\par\vspace{1.6\baselineskip}%
  \begingroup\centering\sblabel{In this part}\par\endgroup\nobreak\vspace{6pt}%
  \begingroup\small\noindent
    \vtop{\hsize=\linewidth \leftskip=1.4em \rightskip=1.4em plus 1fil #1\par}\par\endgroup}
\newcommand{\pch}[3]{\par\noindent\hangindent=2.1em\hangafter=1\relax
  \makebox[1.5em][r]{\color{sbaccent}\bfseries #1}\hspace{0.6em}\hyperref[sbch:#1]{#2}\enspace{\itshape\color{sbgray}#3}\par}

%% ---------------------------------------------------------------------------------------
%% Chapters
%% ---------------------------------------------------------------------------------------
\newcommand{\summarychapter}[3]{%
  \clearpage\thispagestyle{plain}%
  \setcounter{chapter}{#1}\addtocounter{chapter}{-1}\refstepcounter{chapter}%
  \label{sbch:#1}%
  \addcontentsline{toc}{chapter}{\protect\sbtocch{#1}{#2}{#3}}%
  \markright{#2}%
  \vspace*{0.25in}%
  \begingroup\raggedright
    {\sffamily\footnotesize\color{sbaccent}\textls[180]{CHAPTER}\par}\vspace{1pt}%
    {\fontsize{38}{40}\selectfont\color{sbaccent}#1\par}\vspace{7pt}%
    {\color{sbrule}\rule{\linewidth}{0.6pt}\par}\vspace{9pt}%
    {\LARGE #2\par}\vspace{3pt}%
    {\large\itshape\color{sbgray}#3\par}%
  \endgroup
  \vspace{1.5\baselineskip}%
  \@afterindentfalse\@afterheading}

\newcommand{\sb@plainchapter}[1]{%
  \clearpage\thispagestyle{plain}%
  \phantomsection
  \addcontentsline{toc}{chapter}{\protect\sbtocplain{#1}}%
  \markboth{#1}{#1}%
  \vspace*{0.25in}%
  \begingroup\raggedright
    {\LARGE #1\par}\vspace{9pt}%
    {\color{sbrule}\rule{\linewidth}{0.6pt}\par}%
  \endgroup
  \vspace{1.3\baselineskip}%
  \@afterindentfalse\@afterheading}
\newcommand{\frontchapter}{\sb@plainchapter}
\newcommand{\backchapter}{\sb@plainchapter}
%% Back matter: a gap in the contents, and PDF bookmarks beside the parts instead of inside Part Nine.
\g@addto@macro\backmatter{%
  \addtocontents{toc}{\protect\addvspace{1.05\baselineskip}}%
  \gdef\toclevel@chapter{-1}\gdef\toclevel@section{0}}

%% Section headings: in the PDF outline, not in the printed contents.
\setcounter{secnumdepth}{0}
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-1.2\baselineskip \@plus -3pt \@minus -1pt}{0.3\baselineskip}%
  {\normalfont\normalsize\bfseries\color{sbaccent}\raggedright}}
\renewcommand{\sectionmark}[1]{}
\newcommand{\ssection}[1]{\section{#1}}
\renewcommand*{\l@section}[2]{}

%% ---------------------------------------------------------------------------------------
%% Boxes
%% ---------------------------------------------------------------------------------------
%% \sb@need{length}: start a new page unless that much room is left on this one
%% (not directly after a heading, which must stay with what follows it).
\newcommand*{\sb@need}[1]{\par
  \if@nobreak\else
    \begingroup
      \dimen@=#1\relax
      \dimen@ii=\pagegoal \advance\dimen@ii-\pagetotal
      \ifdim\dimen@>\dimen@ii \ifdim\dimen@ii>\z@ \break \fi\fi
    \endgroup
  \fi}
\newmdenv[backgroundcolor=sbtint,linecolor=sbaccent,linewidth=2pt,topline=false,bottomline=false,
  rightline=false,innerleftmargin=11pt,innerrightmargin=11pt,innertopmargin=8pt,innerbottommargin=8pt,
  skipabove=0pt,skipbelow=0.5\baselineskip]{sb@inbrief}
%% After the box the opening paragraph starts flush left.  (\@nobreakfalse: the chapter head has
%% left \if@nobreak set, which would swallow the space above the first section heading.)
\newcommand*{\sb@noindentnext}{\everypar{{\setbox\z@\lastbox}\everypar{}}}
\newenvironment{inbrief}
  {\begin{sb@inbrief}\small\noindent\sblabel{In brief}\par\vspace{3pt}\noindent\ignorespaces}
  {\end{sb@inbrief}\@endpefalse\@nobreakfalse\aftergroup\sb@noindentnext}
\newcommand{\question}[1]{\par\vspace{5pt}\noindent\sblabel{The question}\par\vspace{2pt}\noindent{\itshape #1}\par}

\newmdenv[backgroundcolor=sbtint,linecolor=sbrule,linewidth=0.6pt,innerleftmargin=10pt,
  innerrightmargin=10pt,innertopmargin=8pt,innerbottommargin=8pt,
  skipabove=0.9\baselineskip,skipbelow=0.6\baselineskip]{sb@side}
%% A sidebar is set first and then placed:
%%   - where it stands, if the page has room for it;
%%   - otherwise at the top of the next page, as a float, while the text runs on (so that neither a
%%     short page nor a broken box results);
%%   - a sidebar of more than 0.6 of the text height may instead run over the page, if at least
%%     title + 4 lines stay before the break and 5 lines follow it (3 lines of any one paragraph).
\newbox\sb@sidecontent
\newcommand*\fps@sbsidefloat{t}
\newcommand*\ftype@sbsidefloat{4}
\setcounter{topnumber}{2}\setcounter{totalnumber}{3}
\renewcommand{\topfraction}{0.9}\renewcommand{\textfraction}{0.08}\renewcommand{\floatpagefraction}{0.97}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\@fptop=\z@skip \@fpsep=12pt \@fpbot=0pt plus 1fil
\newenvironment{sidebox}[1]
  {\par
   \setbox\sb@sidecontent=\vbox\bgroup\color@begingroup
     \advance\linewidth-21.2pt \hsize=\linewidth      % the inner width of the frame sb@side
     \let\par\@@par \everypar{}\small
     \clubpenalties=3 \@M \@M \z@ \widowpenalties=3 \@M \@M \z@
     \noindent\sblabel{Sidebar}\hspace{0.8em}{\bfseries #1}\par\nobreak\vspace{3pt}\noindent\ignorespaces}
  {  \par\color@endgroup\egroup
   \sb@placesidebox}
\newcommand*{\sb@placesidebox}{%
  \vbadness=\@M \vfuzz=\maxdimen                            % trial splits are not worth a log entry
  \dimen@=\ht\sb@sidecontent \advance\dimen@\dp\sb@sidecontent
  \advance\dimen@ 23pt \advance\dimen@ 0.9\baselineskip    % padding, frame, space above, a margin
  \count@=\z@                           % 0: here   1: top of the next page   2: new page, then here
  \ifx\@deferlist\@empty
    \if@nobreak\else\ifdim\pagegoal<\maxdimen
      \dimen@ii=\pagegoal \advance\dimen@ii-\pagetotal
      \ifdim\dimen@>\dimen@ii                               % it does not fit on this page
        \ifdim\dimen@<0.6\textheight
          \count@=\@ne
        \else
          \ifdim\dimen@ii<7\baselineskip \count@=\tw@ \fi   % no room to start it here
          \ifnum\count@=\z@ \ifdim\dimen@<\textheight       % would it split well?  try it on a copy
            \advance\dimen@ii-23pt \advance\dimen@ii-0.9\baselineskip
            \setbox\@tempboxa=\copy\sb@sidecontent
            \setbox\z@=\vsplit\@tempboxa to\dimen@ii
            \setbox\z@=\vbox{\unvbox\z@}%
            \ifdim\ht\z@<60pt \count@=\tw@ \fi
            \ifdim\ht\@tempboxa<52pt \count@=\tw@ \fi
            \setbox\z@=\box\voidb@x \setbox\@tempboxa=\box\voidb@x
          \fi\fi
          \ifnum\count@=\tw@ \ifdim\dimen@<0.8\textheight \count@=\@ne \fi\fi
        \fi
      \fi
    \fi\fi
  \else                                 % an earlier sidebar waits for the next page: stay behind it
    \ifdim\dimen@<0.8\textheight \count@=\@ne \else \count@=\tw@ \fi
  \fi
  \ifcase\count@
    \begin{sb@side}\unvbox\sb@sidecontent\end{sb@side}%
  \or
    \@float{sbsidefloat}[t]%
      \begin{sb@side}[skipabove=0pt,skipbelow=0pt]\unvbox\sb@sidecontent\end{sb@side}%
    \end@float
  \else
    \newpage
    \begin{sb@side}\unvbox\sb@sidecontent\end{sb@side}%
  \fi}

%% Small tables (the book's own tables, condensed):
%%   \begin{sumtable}[Caption]{L{0.47\linewidth}L{0.47\linewidth}}
%%   \sumhead{..} & \sumhead{..} \\ \midrule   row & row \\ ...   \end{sumtable}   (end the last row with \\)
%% A table is never divided.  Where it does not fit on the page it goes to the top of the next page and the
%% text runs on, so the sentence that introduces it must not depend on the table following at once.
\newcolumntype{L}[1]{>{\raggedright\arraybackslash\hspace{0pt}}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash\hspace{0pt}}p{#1}}
\newbox\sb@tabbox
\newenvironment{sumtable}[2][]
  {\par
   \setbox\sb@tabbox=\vbox\bgroup\color@begingroup
     \hsize=\linewidth \let\par\@@par \everypar{}\parindent=\z@
     \def\sb@tabcaption{#1}%
     \ifx\sb@tabcaption\@empty\else \noindent\sblabel{#1}\par\nobreak\vspace{4.5pt}\fi
     \noindent\footnotesize\setlength{\tabcolsep}{5pt}\renewcommand{\arraystretch}{1.3}%
     \begin{tabular}{@{}#2@{}}\toprule}
  {\bottomrule\end{tabular}\par\color@endgroup\egroup
   \sb@placetable}
\newcommand*{\sb@placetable}{%
  \dimen@=\ht\sb@tabbox \advance\dimen@\dp\sb@tabbox \advance\dimen@ 12pt
  \count@=\z@                                   % 0: here   1: top of the next page
  \ifinner\else
    \ifx\@deferlist\@empty
      \if@nobreak\else\ifdim\pagegoal<\maxdimen
        \dimen@ii=\pagegoal \advance\dimen@ii-\pagetotal
        \ifdim\dimen@>\dimen@ii \count@=\@ne \fi
      \fi\fi
    \else
      \count@=\@ne                               % stay behind a box that waits for the next page
    \fi
  \fi
  \ifcase\count@
    \vspace{5pt}\noindent\box\sb@tabbox\par\vspace{5pt}%
  \or
    \@float{sbsidefloat}[t]\noindent\box\sb@tabbox\end@float
  \fi}
\newcommand{\sumhead}[1]{{\sffamily\bfseries\scriptsize #1}}

%% Key facts at the end of a chapter.  The block is set first and then placed: in one piece where
%% it fits; in one piece on the next page when little room is left on this one; otherwise it runs
%% over the page between two entries (the key terms always stay with the closing rule).
\newbox\sb@kfbox
\newenvironment{keyfacts}
  {\par
   \setbox\sb@kfbox=\vbox\bgroup\color@begingroup
     \hsize=\linewidth \let\par\@@par \everypar{}%
     \small\parindent=0pt \clubpenalty=\@M \widowpenalty=\@M
     \noindent{\color{sbaccent}\rule{\linewidth}{1pt}}\par\nobreak}
  {  \par\nobreak\vspace{5pt}\noindent{\color{sbrule}\rule{\linewidth}{0.5pt}}\par
   \color@endgroup\egroup
   \sb@placekeyfacts}
\newcommand*{\sb@placekeyfacts}{%
  \ifx\@deferlist\@empty\else \newpage \fi            % a sidebar waits for the next page: it comes first
  \dimen@=\ht\sb@kfbox \advance\dimen@\dp\sb@kfbox \advance\dimen@ 2pt      % height of the block
  \ifdim\pagegoal=\maxdimen
    \dimen@ii=\maxdimen                                                     % empty page
  \else
    \dimen@ii=\pagegoal \advance\dimen@ii-\pagetotal \advance\dimen@ii-1.5\baselineskip
  \fi
  \@tempswafalse
  \ifdim\dimen@>\dimen@ii
    \ifdim\dimen@ii<0.3\textheight \ifdim\dimen@<\textheight \@tempswatrue \fi\fi
  \fi
  \if@tempswa \newpage \else \addvspace{1.5\baselineskip}\fi
  \unvbox\sb@kfbox}
\newcommand{\sb@keyhead}[1]{\par\vspace{5pt}\noindent\sblabel{#1}\par\nobreak\vspace{1pt}}
\newcommand{\keypeople}[1]{\sb@keyhead{Key people}{\raggedright\noindent\ignorespaces #1\par}}
\newcommand{\keyterms}[1]{\sb@keyhead{Key terms}{\raggedright\interlinepenalty=\@M\noindent\ignorespaces #1\par}}
%% The last three dates stay with the key terms, so that a block that runs over the page does not
%% leave two or three lines on the last page of the chapter.
\newcount\sb@kdn \newcount\sb@kdi
\newcommand{\keydates}[1]{\sb@keyhead{Key dates}{\raggedright
  \sb@kdn=\z@ \begingroup\def\kd##1##2{\global\advance\sb@kdn\@ne}#1\endgroup
  \sb@kdi=\z@ #1\par}}
\newcommand{\kd}[2]{\par\noindent\hangindent=6.3em\hangafter=1\relax\makebox[6.3em][l]{\bfseries #1}#2\par
  \advance\sb@kdi\@ne \advance\sb@kdi\tw@
  \ifnum\sb@kdi<\sb@kdn \else \nobreak \fi
  \advance\sb@kdi-\tw@}

%% ---------------------------------------------------------------------------------------
%% Contents
%% ---------------------------------------------------------------------------------------
\newcommand*{\sb@dots}{\nobreak\leaders\hbox to 0.7em{\hss.\hss}\hfill\nobreak}
\newcommand*{\sb@tocsub}{}
\newcommand{\sbtocpart}[3]{\sblabel{Part #1}\hspace{0.9em}{\bfseries #2}\hspace{0.7em}{\small\color{sbgray}#3}}
\newcommand{\sbtocch}[3]{\gdef\sb@tocsub{#3}\makebox[1.5em][r]{\color{sbaccent}\bfseries #1}\hspace{0.7em}#2}
\newcommand{\sbtocplain}[1]{\gdef\sb@tocsub{}#1}
\renewcommand*{\l@part}[2]{\addpenalty{-\@highpenalty}\addvspace{1.05\baselineskip}%
  {\noindent #1\par}\nobreak\vspace{0.25\baselineskip}}
\renewcommand*{\l@chapter}[2]{\par\noindent #1\sb@dots #2\par
  \ifx\sb@tocsub\@empty\else\nobreak
    \noindent\hspace*{2.2em}{\small\itshape\color{sbgray}\sb@tocsub}\par\vspace{0.18\baselineskip}\fi}
\renewcommand{\tableofcontents}{%
  \clearpage\thispagestyle{plain}\markboth{Contents}{Contents}%
  \pdfbookmark[0]{Contents}{sb-contents}%
  \vspace*{0.25in}%
  \begingroup\raggedright{\LARGE Contents\par}\vspace{9pt}{\color{sbrule}\rule{\linewidth}{0.6pt}\par}\endgroup
  \vspace{1.3\baselineskip}\@starttoc{toc}}

%% ---------------------------------------------------------------------------------------
%% Small helpers
%% ---------------------------------------------------------------------------------------
\newcommand{\booktitle}[1]{\textit{#1}}
%% One of the nine ages in "The Book at a Glance": \age{n}{Title}{dates and chapters}{text}
\newcommand{\age}[4]{\par\addvspace{0.75\baselineskip}\noindent
  \makebox[1.2em][l]{\color{sbaccent}\bfseries #1}{\bfseries #2}\enspace{\small\color{sbgray}#3}\par\nobreak
  \noindent\hspace*{1.2em}\parbox[t]{\dimexpr\linewidth-1.2em\relax}{\small\strut #4\strut}\par}
%% List of popes (back/popes.tex, generated): popecolumns with \pope{years}{name}, then popelegend.
\newenvironment{popecolumns}{\begin{multicols}{3}\footnotesize\raggedright}{\end{multicols}}
\newcommand{\pope}[2]{\noindent\hangindent=1em\hangafter=1\relax{\color{sbgray}#1}\enspace #2\par}
\newenvironment{popelegend}{\par\addvspace{0.9\baselineskip}\begingroup\footnotesize\raggedright}{\par\endgroup}
\newcommand{\popemark}{\par\noindent}

%% Chronology (back/chronology.tex, generated):
%%   \chronhead{Fourth century}   \chron{325}{event}{ch.~\chref{10}}   \chronmore{event}{ch.~\chref{14}}
%% \chronmore is a further event of the same date.  The date is printed once; if a page break falls
%% inside the group, the first entry on the new page shows the date again (in regular weight).  For this
%% every entry notes its page in the .aux file, so the dates are right from the second run on.
\newlength{\sb@chronw}
\setlength{\sb@chronw}{5.7em}
\newenvironment{chronology}
  {\par\begingroup\small\raggedright\setlength{\parskip}{1.5pt}}
  {\par\endgroup}
\newcommand{\chronhead}[1]{\par\addvspace{1.15\baselineskip}%
  \noindent\sblabel{#1}\par\nobreak\vspace{3pt}\nobreak}
\newcount\sb@chronn
\newcommand*{\sb@chronpage}[2]{\expandafter\gdef\csname sbcp@#1\endcsname{#2}}
\newcommand*{\sb@chronmark}{%                  note the page of this entry in the .aux file
  \global\advance\sb@chronn\@ne
  \begingroup\edef\x{\endgroup
    \noexpand\protected@write\noexpand\@auxout{}%
      {\noexpand\string\noexpand\sb@chronpage{\the\sb@chronn}{\noexpand\thepage}}}\x}
\newcommand*{\sb@chronlast}[1]{\expandafter\ifx\csname sbcp@#1\endcsname\relax ?\else\csname sbcp@#1\endcsname\fi}
\newcommand*{\sb@ifnewpage}[2]{%               #1 if this entry began a new page in the last run, else #2
  \begingroup \count@=\sb@chronn \advance\count@\m@ne
  \edef\x{\endgroup\noexpand\sb@pagecmp{\sb@chronlast{\the\sb@chronn}}{\sb@chronlast{\the\count@}}}%
  \x{#1}{#2}}
\newcommand*{\sb@pagecmp}[4]{\def\sb@tempa{#1}\def\sb@tempb{#2}\ifx\sb@tempa\sb@tempb #4\else #3\fi}
\newcommand{\chron}[3]{\par\noindent\hangindent=\sb@chronw\hangafter=1\relax
  \sb@chronmark\gdef\sb@chrondate{#1}%
  \makebox[\sb@chronw][l]{\bfseries #1}#2\enspace{\footnotesize\color{sbgray}(#3)}\par}
\newcommand{\chronmore}[2]{\par\noindent\hangindent=\sb@chronw\hangafter=1\relax
  \sb@chronmark
  \sb@ifnewpage{\makebox[\sb@chronw][l]{\sb@chrondate}}{\hspace*{\sb@chronw}}%
  #1\enspace{\footnotesize\color{sbgray}(#2)}\par}
%% A chapter number that links to the chapter (every \summarychapter{n} sets the label sbch:n).
\newcommand{\chref}[1]{\hyperref[sbch:#1]{#1}}

