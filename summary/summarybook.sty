%% PDF outline and links
%% ---------------------------------------------------------------------------------------
\RequirePackage[hidelinks,bookmarksopen=false,bookmarksdepth=2]{hyperref}
\@namedef{sb@pn@ONE}{One}\@namedef{sb@pn@TWO}{Two}\@namedef{sb@pn@THREE}{Three}
\@namedef{sb@pn@FOUR}{Four}\@namedef{sb@pn@FIVE}{Five}\@namedef{sb@pn@SIX}{Six}
\@namedef{sb@pn@SEVEN}{Seven}\@namedef{sb@pn@EIGHT}{Eight}\@namedef{sb@pn@NINE}{Nine}
\pdfstringdefDisableCommands{%
  \def\sbtocch#1#2#3{#1. #2}\def\sbtocpart#1#2#3{Part \csname sb@pn@#1\endcsname: #2}%
  \def\sbtocplain#1{#1}}
\endinput
